# Copy to .env.local and fill in.
# Values come from Supabase project settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose to the browser. Used by the cron worker to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key for the verdict generator (Claude Haiku 4.5).
# Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Web push (VAPID). Generate the key pair once with:
#   npx web-push generate-vapid-keys
# The public key is inlined into the client bundle, so it must be set at
# build time (locally AND in Vercel). The subject is a contact URI the push
# services can reach you at.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the daily cron at /api/cron/notify. Vercel sends this
# automatically as Authorization: Bearer <CRON_SECRET>. Generate with:
#   openssl rand -hex 32
# Set the same value in your Vercel project's environment variables.
CRON_SECRET=YOUR-RANDOM-SECRET
